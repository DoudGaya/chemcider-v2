# ==============================================================================
# Chemcider Website - Public Site Environment Variables Template
# ==============================================================================
# Copy this file to '.env.local' in the root directory for local development.
# These variables must also be configured in Vercel project settings for deployment.

# The Sanity Project ID (obtain this from the Sanity Manage dashboard: https://sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=

# The dataset to use (defaults to "production")
NEXT_PUBLIC_SANITY_DATASET=production

# The API version for querying Sanity CMS (formatted as YYYY-MM-DD)
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01

# Optional API read token (required ONLY for previewing draft content or reading private datasets)
# DO NOT expose this token in NEXT_PUBLIC_ prefixed variables or commit it.
SANITY_API_READ_TOKEN=

# The absolute URL of the public website (used for canonical links, sitemaps, and manifest files)
NEXT_PUBLIC_SITE_URL=https://chemcider.com


# ==============================================================================
# Chemcider Website - Sanity Studio Environment Variables Template
# ==============================================================================
# Copy this file to '.env' (or '.env.local') in the 'studio' directory for local dev.
# These variables should also be set if deploying Sanity Studio to Vercel/Netlify.

# The Sanity Project ID (obtain this from the Sanity Manage dashboard: https://sanity.io/manage)
SANITY_STUDIO_PROJECT_ID=

# The dataset to use (defaults to "production")
SANITY_STUDIO_DATASET=production

# The display title of the Chemcider Content Studio
SANITY_STUDIO_TITLE="Chemcider Content Studio"

# Optional App ID for fine-grained version management on Sanity's CDN
SANITY_STUDIO_APP_ID=

